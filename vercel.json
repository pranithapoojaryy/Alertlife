{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    }
  },
  "routes": [
    { "src": "/api(/.*)?", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/assets/(.*)", "dest": "/frontend/dist/assets/$1" },
    { "src": "/(.*\\.(?:js|css|svg|png|jpg|jpeg|gif|webp|json|ico|txt|webmanifest))", "dest": "/frontend/dist/$1" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ]
}
