{
  "name": "alertlink",
  "version": "1.0.0",
  "description": "Alert Link - Root",
  "scripts": {
    "postinstall": "cd frontend && npm install",
    "build": "cd frontend && npm install && npm run build && cd .. && cp -r frontend/dist ./dist 2>/dev/null || true",
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd backend && npm run dev",
    "client": "cd frontend && npm run dev",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "ws": "^8.21.3"
  }
}
